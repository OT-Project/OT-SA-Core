<model>
    <mount>//OPNsense/auth/sshuser</mount>
    <version>1.0.0</version>
    <description>SSH User Access Management</description>
    <items>
        <users>
            <user type="ArrayField">
                <enabled type="BooleanField">
                    <Default>1</Default>
                    <Required>Y</Required>
                </enabled>
                <username type="ModelRelationField">
                    <Model>
                        <template>
                            <source>OPNsense.Auth.User</source>
                            <items>user</items>
                            <display>name</display>
                        </template>
                    </Model>
                    <Required>Y</Required>
                    <ValidationMessage>Please select a valid system user.</ValidationMessage>
                    <Constraints>
                        <check001>
                            <type>UniqueConstraint</type>
                            <ValidationMessage>This user already has an SSH entry.</ValidationMessage>
                        </check001>
                    </Constraints>
                </username>
                <sshPublicKey type="TextField">
                    <Mask>/^(ssh-rsa|ssh-ed25519|ecdsa-sha2-nistp256|ecdsa-sha2-nistp384|ecdsa-sha2-nistp521|sk-ssh-ed25519@openssh\.com|sk-ecdsa-sha2-nistp256@openssh\.com)\s.+$/u</Mask>
                    <ValidationMessage>Must be a valid SSH public key starting with a recognized key type (ssh-rsa, ssh-ed25519, ecdsa-sha2-*, etc.).</ValidationMessage>
                </sshPublicKey>
                <authMethod type="OptionField">
                    <Default>key_only</Default>
                    <Required>Y</Required>
                    <OptionValues>
                        <key_only>Key Only</key_only>
                        <password>Password</password>
                        <both>Key + Password</both>
                    </OptionValues>
                </authMethod>
                <shell type="OptionField">
                    <Default>/usr/local/sbin/opnsense-shell</Default>
                    <Required>Y</Required>
                    <OptionValues>
                        <opnsense_shell value="/usr/local/sbin/opnsense-shell">OPNsense Shell</opnsense_shell>
                        <bourne_shell value="/bin/sh">Bourne Shell</bourne_shell>
                        <c_shell value="/bin/csh">C Shell</c_shell>
                        <tenex_shell value="/bin/tcsh">TENEX C Shell</tenex_shell>
                        <bash value="/usr/local/bin/bash">Bash</bash>
                        <nologin value="/usr/sbin/nologin">No Login</nologin>
                    </OptionValues>
                </shell>
                <permissionGroup type="OptionField">
                    <Default>operator</Default>
                    <Required>Y</Required>
                    <OptionValues>
                        <admin>Admin (Full access)</admin>
                        <operator>Operator (Service management)</operator>
                        <viewer>Viewer (Read-only)</viewer>
                    </OptionValues>
                </permissionGroup>
                <allowedNetworks type="CSVListField"/>
                <sessionTimeout type="IntegerField">
                    <Default>30</Default>
                    <Required>Y</Required>
                    <MinimumValue>0</MinimumValue>
                    <MaximumValue>1440</MaximumValue>
                    <ValidationMessage>Session timeout must be between 0 (unlimited) and 1440 minutes (24 hours).</ValidationMessage>
                </sessionTimeout>
                <maxSessions type="IntegerField">
                    <Default>3</Default>
                    <Required>Y</Required>
                    <MinimumValue>1</MinimumValue>
                    <MaximumValue>100</MaximumValue>
                    <ValidationMessage>Max sessions must be between 1 and 100.</ValidationMessage>
                </maxSessions>
                <portForwarding type="BooleanField">
                    <Default>0</Default>
                    <Required>Y</Required>
                </portForwarding>
            </user>
        </users>
    </items>
</model>
